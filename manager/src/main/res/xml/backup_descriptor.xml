<?xml version="1.0" encoding="utf-8"?>
<!-- ShizukuBackupAgent.onFullBackup() handles all backup — these XML rules are superseded when a
     backupAgent is declared and overrides onFullBackup(). The previous include of
     sharedpref/settings.xml was wrong: it referenced credential-encrypted storage, which is a
     different file from the device-protected storage that ShizukuSettings actually writes to. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
</full-backup-content>
